[Unit]
Description=XFerry managed HTTP testing service
Documentation=https://github.com/kgmnotes/xferry
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xferry
Group=xferry
WorkingDirectory=/var/lib/xferry
Environment=HOME=/var/lib/xferry
ExecStartPre=/opt/xferry/current/xferry run --config /etc/xferry/xferry.ini --check-config
ExecStart=/opt/xferry/current/xferry run --config /etc/xferry/xferry.ini
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/xferry
StateDirectory=xferry
RuntimeDirectory=xferry
UMask=0077

[Install]
WantedBy=multi-user.target
