# xferry public-direct Docker Compose example.
# Copy to ./xferry.ini before Compose mounts it at /etc/xferry/xferry.ini.

# BEGIN GENERATED: xferry-settings/docker
[server]
access = public
log_level = info
log_format = json
host = 0.0.0.0
port = 8443
files_dir = /data/files
workers = 10

[security]
auth_file = /run/secrets/xferry_auth
allowed_hosts =

[tls]
https_mode = auto
# public_ip = 203.0.113.10
acme_http_port = 8080

[limits]
max_size_mb = 100
upload_storage_limit_mb = 4096
upload_file_limit = 4096
upload_reserve_free_mb = 1024
upload_quota_externally_managed = false
body_memory_budget_mb = 512
body_idle_timeout = 5
body_timeout = 300
body_min_rate = 0
stream_send_idle_timeout = 5
stream_send_timeout = 300

[cors]
cors_origin =

[plugins]
plugin_allowlist =
plugins_allow_public_direct = false
plugins_override_core = false
# END GENERATED: xferry-settings/docker
