#!/bin/sh
set -eu
umask 022

version='@VERSION@'
platform_id='@PLATFORM_ID@'
artifact_name='@EXECUTABLE_NAME@'
artifact_size='@EXECUTABLE_SIZE@'
artifact_sha256='@EXECUTABLE_SHA256@'
manifest_signature_required='@MANIFEST_SIGNATURE_REQUIRED@'
manifest_signature_name='xferry-release.json.sig'
supported_release_major='@SUPPORTED_RELEASE_MAJOR@'
unsupported_managed_state_instructions='@UNSUPPORTED_MANAGED_STATE_INSTRUCTIONS@'
release_base_url="${XFERRY_RELEASE_BASE_URL:-https://github.com/kgmnotes/xferry/releases/download/v@VERSION@}"
destdir="${DESTDIR:-}"

if [ "$(id -u)" -ne 0 ]; then
  echo 'xferry installer must run as root' >&2
  exit 3
fi

host_machine="$(uname -m)"
if [ "$(uname -s)" != 'Linux' ]; then
  echo 'xferry supports @PLATFORM_DESCRIPTION@ only' >&2
  exit 4
fi
case "$host_machine" in
  @MACHINE_CASE_PATTERN@) ;;
  *)
    echo 'xferry supports @PLATFORM_DESCRIPTION@ only' >&2
    exit 4
    ;;
esac

probe_root="$destdir"
os_release="$probe_root/etc/os-release"
systemd_runtime="$probe_root/run/systemd/system"
meminfo="$probe_root/proc/meminfo"

if [ ! -r "$os_release" ]; then
  echo 'xferry requires @MANAGED_HOST_DESCRIPTION@' >&2
  exit 4
fi

os_id="$(awk -F= '$1 == "ID" { value=$2; gsub(/^"|"$/, "", value); print value; exit }' "$os_release")"
os_version="$(awk -F= '$1 == "VERSION_ID" { value=$2; gsub(/^"|"$/, "", value); print value; exit }' "$os_release")"
case "$os_id:$os_version" in
  @MANAGED_OS_CASE_PATTERN@) ;;
  *)
    echo 'xferry requires @MANAGED_HOST_DESCRIPTION@' >&2
    exit 4
    ;;
esac

if [ ! -d "$systemd_runtime" ]; then
  echo 'xferry requires a running systemd host' >&2
  exit 4
fi

if [ ! -r "$meminfo" ]; then
  echo 'xferry requires at least 512 MiB RAM' >&2
  exit 4
fi
mem_kib="$(awk '$1 == "MemTotal:" { print $2; exit }' "$meminfo")"
case "$mem_kib" in
  ''|*[!0-9]*)
    echo 'xferry could not determine host memory' >&2
    exit 4
    ;;
esac
if [ "$mem_kib" -lt 524288 ]; then
  echo 'xferry requires at least 512 MiB RAM' >&2
  exit 4
fi

block_unsupported_managed_state() {
  echo "$unsupported_managed_state_instructions" >&2
  exit 1
}

path_present() {
  [ -e "$1" ] || [ -L "$1" ]
}

real_directory() {
  [ -d "$1" ] && [ ! -L "$1" ]
}

regular_file() {
  [ -f "$1" ] && [ ! -L "$1" ]
}

valid_supported_version() {
  candidate_version="$1"
  printf '%s\n' "$candidate_version" \
    | grep -Eq '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)([-+][0-9A-Za-z][0-9A-Za-z.-]*)?$' \
    || return 1
  [ "${candidate_version%%.*}" = "$supported_release_major" ]
}

valid_supported_release() {
  candidate_release="$1"
  candidate_version="$2"
  required_schema="${3:-any}"
  candidate_manifest="$candidate_release/xferry-release.json"
  candidate_signature="$candidate_release/$manifest_signature_name"
  candidate_executable="$candidate_release/xferry"
  real_directory "$candidate_release" || return 1
  regular_file "$candidate_manifest" || return 1
  regular_file "$candidate_executable" || return 1
  [ -x "$candidate_executable" ] || return 1
  candidate_manifest_size="$(wc -c < "$candidate_manifest" | tr -d '[:space:]')"
  case "$candidate_manifest_size" in
    ''|*[!0-9]*) return 1 ;;
  esac
  [ "$candidate_manifest_size" -gt 0 ] && [ "$candidate_manifest_size" -le 65536 ] || return 1
  candidate_manifest_fields="$(
    awk \
      -v expected_version="$candidate_version" \
      -v expected_platform="$platform_id" \
      -v required_schema="$required_schema" \
      -v expected_name="xferry-$candidate_version-$platform_id" '
      function invalid() { exit 1 }
      function declared_size(line, prefix, value) {
        prefix = "    \"size\": "
        if (index(line, prefix) != 1) invalid()
        if (substr(line, length(line), 1) != ",") invalid()
        value = substr(line, length(prefix) + 1, length(line) - length(prefix) - 1)
        if (value !~ /^[1-9][0-9]*$/) invalid()
        return value
      }
      function declared_sha256(line, prefix, value) {
        prefix = "    \"sha256\": \""
        if (index(line, prefix) != 1) invalid()
        if (substr(line, length(line), 1) != "\"") invalid()
        value = substr(line, length(prefix) + 1, length(line) - length(prefix) - 1)
        if (length(value) != 64 || value ~ /[^0-9a-f]/) invalid()
        return value
      }
      function source_value(line, prefix, comma, value) {
        if (index(line, prefix) != 1) invalid()
        comma = substr(line, length(line) - 1, 2)
        if (comma == "\",") {
          value = substr(line, length(prefix) + 1, length(line) - length(prefix) - 2)
        } else if (substr(line, length(line), 1) == "\"") {
          value = substr(line, length(prefix) + 1, length(line) - length(prefix) - 1)
        } else {
          invalid()
        }
        return value
      }
      { lines[NR] = $0 }
      END {
        if (lines[1] != "{") invalid()
        if (lines[3] != "  \"version\": \"" expected_version "\",") invalid()
        if (lines[4] != "  \"tag\": \"v" expected_version "\",") invalid()
        if (lines[5] != "  \"platform\": \"" expected_platform "\",") invalid()
        if (lines[6] != "  \"executable\": {") invalid()
        if (lines[7] != "    \"name\": \"" expected_name "\",") invalid()
        size = declared_size(lines[8])
        sha256 = declared_sha256(lines[9])

        if (lines[2] == "  \"schema_version\": 1,") {
          if (required_schema == "2") invalid()
          if (NR != 11 || lines[10] != "  }" || lines[11] != "}") invalid()
          print size ":" sha256 ":0"
          exit 0
        }
        if (lines[2] != "  \"schema_version\": 2,") invalid()
        if (lines[10] != "  }," || lines[11] != "  \"source\": {") invalid()

        if (substr(lines[12], length(lines[12]) - 1, 2) != "\",") invalid()
        if (substr(lines[13], length(lines[13]) - 1, 2) == "\",") invalid()
        commit = source_value(lines[12], "    \"commit\": \"")
        if ((length(commit) != 40 && length(commit) != 64) || commit ~ /[^0-9a-f]/) invalid()
        workflow_run = source_value(lines[13], "    \"workflow_run\": \"")
        if (workflow_run != "local" && workflow_run !~ /^[1-9][0-9]*$/) invalid()
        if (lines[14] != "  }," || lines[15] != "  \"artifact_digests\": {") invalid()

        artifact_end = 0
        expected_digest_seen = 0
        for (line_number = 16; line_number <= NR; line_number++) {
          if (lines[line_number] == "  },") {
            artifact_end = line_number
            break
          }
        }
        if (artifact_end <= 16) invalid()
        for (line_number = 16; line_number < artifact_end; line_number++) {
          entry = lines[line_number]
          if (substr(entry, 1, 5) != "    \"") invalid()
          has_comma = substr(entry, length(entry), 1) == ","
          if (line_number < artifact_end - 1 && !has_comma) invalid()
          if (line_number == artifact_end - 1 && has_comma) invalid()
          if (has_comma) {
            entry = substr(entry, 1, length(entry) - 1)
          }
          entry = substr(entry, 6)
          separator = index(entry, "\": \"")
          if (!separator || substr(entry, length(entry), 1) != "\"") invalid()
          name = substr(entry, 1, separator - 1)
          digest = substr(entry, separator + 4, length(entry) - separator - 4)
          if (name !~ /^[0-9A-Za-z][0-9A-Za-z._+-]*$/) invalid()
          if (length(name) > 255 || length(digest) != 64) invalid()
          if (digest ~ /[^0-9a-f]/ || seen[name]) invalid()
          seen[name] = 1
          artifact_count++
          if (artifact_count > @MAX_ARTIFACT_DIGESTS@) invalid()
          if (name == expected_name && digest == sha256) expected_digest_seen = 1
        }
        if (!expected_digest_seen) invalid()
        if (lines[artifact_end + 1] != "  \"signing\": {") invalid()
        signing_scheme = lines[artifact_end + 2]
        signing_key_ids = lines[artifact_end + 3]
        if (signing_scheme == "    \"scheme\": \"unsigned\",") {
          if (signing_key_ids != "    \"key_ids\": []") invalid()
          signature_required = 0
          signing_end = artifact_end + 5
        } else if (signing_scheme == "    \"scheme\": \"ed25519\",") {
          if (signing_key_ids != "    \"key_ids\": [") invalid()
          signing_key_id = lines[artifact_end + 4]
          if (signing_key_id !~ /^      "[a-z0-9][a-z0-9._-]*[a-z0-9]"$/ &&
              signing_key_id !~ /^      "[a-z0-9]"$/) invalid()
          if (length(signing_key_id) > 72) invalid()
          if (lines[artifact_end + 5] != "    ]") invalid()
          signature_required = 1
          signing_end = artifact_end + 7
        } else {
          invalid()
        }
        if (lines[signing_end - 1] != "  }" || lines[signing_end] != "}") invalid()
        if (NR != signing_end) invalid()
        print size ":" sha256 ":" signature_required
      }
    ' "$candidate_manifest"
  )" || return 1
  candidate_declared_size="${candidate_manifest_fields%%:*}"
  candidate_manifest_remainder="${candidate_manifest_fields#*:}"
  candidate_declared_sha256="${candidate_manifest_remainder%%:*}"
  candidate_signature_required="${candidate_manifest_remainder#*:}"
  case "$candidate_signature_required" in
    0) ;;
    1)
      regular_file "$candidate_signature" || return 1
      candidate_signature_size="$(wc -c < "$candidate_signature" | tr -d '[:space:]')"
      case "$candidate_signature_size" in
        ''|*[!0-9]*) return 1 ;;
      esac
      [ "$candidate_signature_size" -gt 0 ] \
        && [ "$candidate_signature_size" -le 4096 ] \
        || return 1
      ;;
    *) return 1 ;;
  esac
  candidate_executable_size="$(wc -c < "$candidate_executable" | tr -d '[:space:]')"
  case "$candidate_executable_size" in
    ''|*[!0-9]*) return 1 ;;
  esac
  [ "$candidate_executable_size" = "$candidate_declared_size" ] || return 1
  candidate_executable_sha256="$(sha256sum "$candidate_executable" | awk '{print $1}')" \
    || return 1
  [ "$candidate_executable_sha256" = "$candidate_declared_sha256" ] || return 1
  return 0
}

release_root="$destdir/opt/xferry"
releases_root="$release_root/releases"
current_link="$release_root/current"
valid_supported_marker=false

if path_present "$release_root"; then
  real_directory "$release_root" || block_unsupported_managed_state
  real_directory "$releases_root" || block_unsupported_managed_state
  [ -L "$current_link" ] || block_unsupported_managed_state

  release_count="$(
    find "$releases_root" -mindepth 1 -maxdepth 1 -printf '.\n' \
      | head -n 129 \
      | wc -l \
      | tr -d '[:space:]'
  )"
  case "$release_count" in
    ''|*[!0-9]*) block_unsupported_managed_state ;;
  esac
  [ "$release_count" -gt 0 ] && [ "$release_count" -le 128 ] || block_unsupported_managed_state

  current_target="$(readlink "$current_link")" || block_unsupported_managed_state
  case "$current_target" in
    releases/*) current_version="${current_target#releases/}" ;;
    *) block_unsupported_managed_state ;;
  esac
  valid_supported_version "$current_version" || block_unsupported_managed_state
  current_seen=false
  for candidate_release in \
    "$releases_root"/* \
    "$releases_root"/.[!.]* \
    "$releases_root"/..?*
  do
    path_present "$candidate_release" || continue
    candidate_version="${candidate_release##*/}"
    valid_supported_version "$candidate_version" || block_unsupported_managed_state
    valid_supported_release "$candidate_release" "$candidate_version" \
      || block_unsupported_managed_state
    if [ "$candidate_version" = "$current_version" ]; then
      current_seen=true
    fi
  done
  [ "$current_seen" = true ] || block_unsupported_managed_state
  valid_supported_marker=true
fi

config_file="$destdir/etc/xferry/xferry.ini"
auth_file="$destdir/etc/xferry/auth"
data_root="$destdir/var/lib/xferry"
unit_file="$destdir/etc/systemd/system/xferry.service"
cli_link="$destdir/usr/local/bin/xferry"

if [ "$valid_supported_marker" = true ]; then
  for owned_file in "$config_file" "$auth_file" "$unit_file"; do
    if path_present "$owned_file"; then
      regular_file "$owned_file" || block_unsupported_managed_state
    fi
  done
  if path_present "$data_root"; then
    real_directory "$data_root" || block_unsupported_managed_state
  fi
  if path_present "$cli_link"; then
    [ -L "$cli_link" ] || block_unsupported_managed_state
    [ "$(readlink "$cli_link")" = '/opt/xferry/current/xferry' ] \
      || block_unsupported_managed_state
  fi
else
  for owned_path in "$config_file" "$auth_file" "$data_root" "$unit_file" "$cli_link"; do
    if path_present "$owned_path"; then
      block_unsupported_managed_state
    fi
  done
fi

stage_dir="$(mktemp -d)"
cleanup() {
  rm -rf "$stage_dir"
}
trap cleanup EXIT HUP INT TERM

downloaded="$stage_dir/$artifact_name"
curl -fsSL --retry 3 -o "$downloaded" "$release_base_url/$artifact_name"

downloaded_signature=''
if [ "$manifest_signature_required" = true ]; then
  downloaded_signature="$stage_dir/$manifest_signature_name"
  curl -fsSL --retry 3 \
    -o "$downloaded_signature" \
    "$release_base_url/$manifest_signature_name"
fi

actual_size="$(wc -c < "$downloaded" | tr -d '[:space:]')"
if [ "$actual_size" != "$artifact_size" ]; then
  echo "xferry download has unexpected size: $actual_size" >&2
  exit 1
fi

actual_sha256="$(sha256sum "$downloaded" | awk '{print $1}')"
if [ "$actual_sha256" != "$artifact_sha256" ]; then
  echo 'xferry download checksum verification failed' >&2
  exit 1
fi

candidate_release="$stage_dir/candidate"
mkdir "$candidate_release"
chmod 0755 "$candidate_release"
install -m 0755 "$downloaded" "$candidate_release/xferry"
cat > "$candidate_release/xferry-release.json" <<'XFERRY_CANDIDATE_MANIFEST'
@MANIFEST_JSON@
XFERRY_CANDIDATE_MANIFEST
chmod 0644 "$candidate_release/xferry-release.json"
if [ "$manifest_signature_required" = true ]; then
  install -m 0644 "$downloaded_signature" "$candidate_release/$manifest_signature_name"
fi
if ! valid_supported_release "$candidate_release" "$version" 2; then
  echo 'xferry candidate manifest or executable is invalid' >&2
  exit 1
fi

release_path="$release_root/releases/$version"
bin_root="$destdir/usr/local/bin"
if [ -e "$release_path" ]; then
  echo "xferry $version is already installed" >&2
  exit 1
fi

mkdir -p "$release_root/releases" "$bin_root"
install_stage="$release_root/.install-$version-$$"
mkdir "$install_stage"
chmod 0755 "$install_stage"
install -m 0755 "$candidate_release/xferry" "$install_stage/xferry"
install -m 0644 "$candidate_release/xferry-release.json" "$install_stage/xferry-release.json"
if [ "$manifest_signature_required" = true ]; then
  install -m 0644 \
    "$candidate_release/$manifest_signature_name" \
    "$install_stage/$manifest_signature_name"
fi
mv "$install_stage" "$release_path"

ln -s "releases/$version" "$release_root/.current-$version"
mv -Tf "$release_root/.current-$version" "$release_root/current"
ln -s '/opt/xferry/current/xferry' "$bin_root/.xferry-$version"
mv -Tf "$bin_root/.xferry-$version" "$bin_root/xferry"

echo 'XFerry installed. Next: sudo xferry setup'
